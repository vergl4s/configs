COMPOSE_PROJECT_NAME=mediastack

# Run `id` on the host to confirm. Default first non-root user is 1000:1000.
PUID=1000
PGID=1000

# Timezone — full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Storage paths, both at the filesystem root.
# /data is the mergerfs pool mount (see README — combines /mnt/disk1, /mnt/disk2)
# /config holds persistent app configs
# Both must be on filesystems that can hardlink between torrents/, usenet/, media/
FOLDER_FOR_MEDIA=/data
FOLDER_FOR_DATA=/config

# VPN — custom WireGuard server (NOT a commercial provider)
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.0.0.2/32

# Download client ports (published via Gluetun).
# SAB listens on 8080 internally and has no env var to change it,
# so keep SABNZBD_PORT=8080 unless you reconfigure SAB after first run.
QBITTORRENT_PORT=8200
QBITTORRENT_TORRENT_PORT=6881
SABNZBD_PORT=8080

# Cloudflare bypass proxy
FLARESOLVERR_PORT=8191

# *arr stack
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
READARR_PORT=8787

# Media server + requests
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
