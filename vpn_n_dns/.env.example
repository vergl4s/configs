# Copy to .env and fill in. .env holds the Cloudflare token, so: chmod 600 .env

# Run `id` on the host to confirm. Default first non-root user is 1000:1000.
PUID=1000
PGID=1000

# Timezone — full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Australia/Sydney

# WireGuard: this VPS's public IP (or a hostname that resolves to it)
SERVERURL=

# Number of peers (e.g. 3) or comma-separated names (e.g. phone,laptop)
PEERS=

# certbot: the certificate covers *.DOMAIN — matches the Cloudflare A record *.dns
DOMAIN=dns.example.com

# Cloudflare API token ("Edit zone DNS" template, limited to this zone)
CF_API_TOKEN=

# Secret DNS-over-TLS hostname. Generate with `openssl rand -hex 12`. haproxy
# drops any connection on 853 that doesn't ask for DOT_SECRET.DOMAIN. That full
# hostname is what you type into Android's Private DNS setting.
DOT_SECRET=
